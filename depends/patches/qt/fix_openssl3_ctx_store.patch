-DEFINEFUNC(X509_STORE *, X509_STORE_CTX_get0_store, X509_STORE_CTX *ctx, ctx, return nullptr, return)
+
+// OpenSSL 3.x compatibility shim: X509_STORE_CTX_get0_store() was removed.
+// Define a replacement that calls the new API if available.
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+X509_STORE *q_X509_STORE_CTX_get0_store(X509_STORE_CTX *ctx)
+{
+#if defined(X509_STORE_CTX_get0_cert_store)
+    // OpenSSL 3.x: use the new function
+    return ctx ? X509_STORE_CTX_get0_cert_store(ctx) : nullptr;
+#else
+    // Very old OpenSSL builds may lack both
+    return nullptr;
+#endif
+}
+#else
+// OpenSSL 1.x and LibreSSL: original function still exists
+X509_STORE *q_X509_STORE_CTX_get0_store(X509_STORE_CTX *ctx)
+{
+#ifdef X509_STORE_CTX_get0_store
+    return ctx ? X509_STORE_CTX_get0_store(ctx) : nullptr;
+#else
+    return nullptr;
+#endif
+}
+#endif
+
